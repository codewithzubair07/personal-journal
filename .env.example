# --- Client-side Firebase config (public by Firebase's own design; real
#     protection comes from firestore.rules, not secrecy of these values) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server-only: Firebase Admin SDK (service account) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Server-only: Gemini key sourcing ---
# Set GOOGLE_CLOUD_PROJECT to fetch the key from Secret Manager (production).
# Leave it unset locally and set GEMINI_API_KEY directly for local dev only.
GOOGLE_CLOUD_PROJECT=
GEMINI_SECRET_NAME=gemini-api-key
GEMINI_API_KEY=
